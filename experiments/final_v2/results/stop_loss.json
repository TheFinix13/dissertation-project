      "clock",
      "cash_frac",
      "exposure_frac",
      "pnl"
    ],
    "risk_lambda": 0.0,
    "reward": "wealth_change",
    "action_model": "slice",
    "slice_frac": 0.25,
    "fee": 0.0005
  },
